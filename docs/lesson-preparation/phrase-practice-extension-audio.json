{
  "assets": [
    {
      "id": "PPI-0079e445ee461b8a602f2659",
      "kind": "dialogue_turn_audio",
      "text": "Magst du das Bad?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-01b9788a4cf3a9f4d98a77e7",
      "kind": "dialogue_turn_audio",
      "text": "Sprechen Sie bitte deutlich.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-01de05033100e6d78dadaffd",
      "kind": "dialogue_turn_audio",
      "text": "Können Sie die Klingel reparieren?",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-0326769c860e9b9424e82833",
      "kind": "dialogue_turn_audio",
      "text": "Wie findest du das Sofa?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-038ddb3531db2b6482d4564b",
      "kind": "dialogue_turn_audio",
      "text": "Wie findest du den Schrank?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-06d986496d373fd316cbc78b",
      "kind": "dialogue_turn_audio",
      "text": "Ich will einen Blog schreiben.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-0906e370a8fb39fa8ca4975e",
      "kind": "dialogue_turn_audio",
      "text": "Ich finde ihren Schrank praktisch.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-09c21beaadbbf83a45cd5b3e",
      "kind": "dialogue_turn_audio",
      "text": "Magst du den Balkon?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-09e6fd588cc1f0183c639f33",
      "kind": "dialogue_turn_audio",
      "text": "Sie kostet 850 Euro im Monat.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-0b00f7f648353260785b212c",
      "kind": "dialogue_turn_audio",
      "text": "Wann haben Sie Zeit?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-0bfacd7b3c8ea5d45dd9dee4",
      "kind": "dialogue_turn_audio",
      "text": "Ich finde seine Lampe schön.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-0c9114af0952e4359f76137f",
      "kind": "dialogue_turn_audio",
      "text": "Spreche ich zu laut?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-0ce7d613674b18c5c2e5c481",
      "kind": "dialogue_turn_audio",
      "text": "Ich will in zwei Monaten eine Ausbildung machen.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-0da0dc5515fbcdc769cced9b",
      "kind": "dialogue_turn_audio",
      "text": "Wie findest du Klaras Tisch?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-0dabfafb8ed99210864f6182",
      "kind": "dialogue_turn_audio",
      "text": "Ist das Klaras Tisch?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-0db9b9b300c7230058d5760d",
      "kind": "dialogue_turn_audio",
      "text": "Ich will durch Europa reisen.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-0f026c0113ab699f49b4d7bc",
      "kind": "dialogue_turn_audio",
      "text": "Am Samstag um 11 Uhr habe ich Zeit.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-0f1d049863f8d8e9908c679f",
      "kind": "dialogue_turn_audio",
      "text": "Was willst du auf keinen Fall machen?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-101b390167ecaf363d31d985",
      "kind": "dialogue_turn_audio",
      "text": "Ich soll morgen kommen.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-10d3fdfe277d15b58c967a6c",
      "kind": "dialogue_turn_audio",
      "text": "Sprechen Sie bitte langsam.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-12b2477589ce1cffea8e8727",
      "kind": "dialogue_turn_audio",
      "text": "Ist die Wohnung noch frei?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-135540e16a8674937a5111be",
      "kind": "dialogue_turn_audio",
      "text": "Sprechen Sie bitte laut.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-13a78ab0c454bafb6c632b76",
      "kind": "dialogue_turn_audio",
      "text": "Können Sie den Kühlschrank reparieren?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-1523b19b7a3f09ccacc80d9b",
      "kind": "dialogue_turn_audio",
      "text": "Die Waschmaschine funktioniert nicht.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-1596f45ca282409966016c7d",
      "kind": "dialogue_turn_audio",
      "text": "Am Mittwoch um 14 Uhr habe ich Zeit.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-15b1bf35eaa3ec73ae957e9e",
      "kind": "dialogue_turn_audio",
      "text": "Ja, nach dem Kurs am Freitag habe ich Zeit.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-16b1a3172fa247e845e02d79",
      "kind": "dialogue_turn_audio",
      "text": "Ja, das Wohnzimmer mag ich besonders.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-18fe8188aca3aee58920f0ee",
      "kind": "dialogue_turn_audio",
      "text": "Nein, ich habe Schnupfen.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-19b1b050b12e9c8ab539bc12",
      "kind": "dialogue_turn_audio",
      "text": "Ich will Chef werden.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-19b1f7ea44b278048daa22be",
      "kind": "dialogue_turn_audio",
      "text": "Mein Bauch tut weh.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-1c83772fbd2c9b4032971747",
      "kind": "dialogue_turn_audio",
      "text": "Was willst du werden?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-1cfb3155feb8afa52800bc7c",
      "kind": "dialogue_turn_audio",
      "text": "Ich will im September eine Ausbildung machen.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-1e48707de2701a212ed57f61",
      "kind": "dialogue_turn_audio",
      "text": "Könnt ihr ohne eine Ausbildung anfangen?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-21d77b65f8cc08de88826cce",
      "kind": "dialogue_turn_audio",
      "text": "Ja, kommen Sie am Montag um neun Uhr.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-21e3e67ea981a77bf7ee3e51",
      "kind": "dialogue_turn_audio",
      "text": "Ist das Arbeitszimmer noch frei?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-232e74864f5ff0e183c7fe78",
      "kind": "dialogue_turn_audio",
      "text": "Ja, das Kinderzimmer ist noch frei.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-239ecd7f7e7bfaa7994f3975",
      "kind": "dialogue_turn_audio",
      "text": "Wie findest du Klaras Schrank?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-252304cab8542a3c9e3dcd3f",
      "kind": "dialogue_turn_audio",
      "text": "Ja, die Waschmaschine kann ich reparieren.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-297e32b49b8a2da38fb1218d",
      "kind": "dialogue_turn_audio",
      "text": "Sprechen Sie bitte leise.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-2ce79f82f97b9f9db6ab0c15",
      "kind": "dialogue_turn_audio",
      "text": "Ich will auf einen Berg steigen.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-2d343c95b6e57435dc5826dc",
      "kind": "dialogue_turn_audio",
      "text": "Ich will im Januar eine Ausbildung machen.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-2e0cdb08a7a3ac129c5ddf23",
      "kind": "dialogue_turn_audio",
      "text": "Ist das Kinderzimmer noch frei?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-2f9adb08fce74b0cb830b9f3",
      "kind": "dialogue_turn_audio",
      "text": "Magst du das Wohnzimmer?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-2fb86c6fdc87c3c3bbc57962",
      "kind": "dialogue_turn_audio",
      "text": "Wie findest du die Küche?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-2ffa7d37f4cd683245909635",
      "kind": "dialogue_turn_audio",
      "text": "Hat die Wohnung ein Arbeitszimmer?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-3094ae4d265211f59b72c756",
      "kind": "dialogue_turn_audio",
      "text": "Ja, die Heizung kann ich reparieren.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-36e39d3a5d047d87b2b2669c",
      "kind": "dialogue_turn_audio",
      "text": "Spreche ich zu schnell?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-38237abcf7e3578d3883eb65",
      "kind": "dialogue_turn_audio",
      "text": "Nein, ohne einen Plan können wir nicht anfangen.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-3a201dbfe5a08f0e30ec7efc",
      "kind": "dialogue_turn_audio",
      "text": "Nein, ich habe Kopfschmerzen.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-3a352d53cafd1132fc362e5c",
      "kind": "dialogue_turn_audio",
      "text": "Was ist das Problem?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-3a707f6244eba6cf7ec23be8",
      "kind": "dialogue_turn_audio",
      "text": "Ich komme mit meinem Bruder.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-3cc82498a5160597171c6ef9",
      "kind": "dialogue_turn_audio",
      "text": "Was kann ich für Sie tun?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-3f2dd99f7002651ac7ac6150",
      "kind": "dialogue_turn_audio",
      "text": "Hat die Wohnung einen Garten?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-3f7ccc4e5d9ef5e2998adb9f",
      "kind": "dialogue_turn_audio",
      "text": "Das ist das Kinderzimmer.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-40fb380cc07bdc75b242a347",
      "kind": "dialogue_turn_audio",
      "text": "Was willst du später machen?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-41f3c470c619a21757b2f8ce",
      "kind": "dialogue_turn_audio",
      "text": "Spreche ich zu leise?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-44d1fc088fc1fb8618c0c089",
      "kind": "dialogue_turn_audio",
      "text": "Es kostet 1200 Euro im Monat.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-4536aae69942c61f0a10bf51",
      "kind": "dialogue_turn_audio",
      "text": "Brauchen Sie Hilfe?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-46734f096989ddd1c9f10c7f",
      "kind": "dialogue_turn_audio",
      "text": "Ja, das ist seine Lampe.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-4cc4a6aa3a33fa3a4d548da7",
      "kind": "dialogue_turn_audio",
      "text": "Könnt ihr ohne einen Plan anfangen?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-4d033cf68e39fef8dfde4121",
      "kind": "dialogue_turn_audio",
      "text": "Haben Sie Fieber?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-4d4e82a626823d1250ab5f1d",
      "kind": "dialogue_turn_audio",
      "text": "Das ist das Wohnzimmer.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-4e0864c16837b2be166556e9",
      "kind": "dialogue_turn_audio",
      "text": "Was kostet das Haus im Monat?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-4fe3c2459bc3880a65edd6f0",
      "kind": "dialogue_turn_audio",
      "text": "Magst du die Küche?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-50730d34b9fa093ca187864d",
      "kind": "dialogue_turn_audio",
      "text": "Ja, die Wohnung hat eine Küche.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-510384c41652dc7c7963622f",
      "kind": "dialogue_turn_audio",
      "text": "Was willst du unbedingt machen?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-52d5f0340f3a0ccf522c0443",
      "kind": "dialogue_turn_audio",
      "text": "Wie findest du das Bett?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-530a2a8e866a1762b9f128cf",
      "kind": "dialogue_turn_audio",
      "text": "Ich finde den Schrank zu groß.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-53d18e550f65d9f68fb7dd0d",
      "kind": "dialogue_turn_audio",
      "text": "Soll ich am Dienstag kommen?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-5508c258d7209a8b5e72433b",
      "kind": "dialogue_turn_audio",
      "text": "Wann willst du die Ausbildung machen?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-56217f36ccbc6b7fbe06b47f",
      "kind": "dialogue_turn_audio",
      "text": "Was kostet das Zimmer im Monat?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-56a8531e9ab98ace3c21d862",
      "kind": "dialogue_turn_audio",
      "text": "Was möchtest du noch machen?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-5745dd99ffaf0b2c13a555f4",
      "kind": "dialogue_turn_audio",
      "text": "Ich will auf keinen Fall um die Welt segeln.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-59b8a25fc6e7518dbf43aff7",
      "kind": "dialogue_turn_audio",
      "text": "Ich soll die Tablette nehmen.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-5a55d810bdae4583e230acdc",
      "kind": "dialogue_turn_audio",
      "text": "Ich will auf keinen Fall im Ausland leben.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-5a6aa3969ab2074e21992cc5",
      "kind": "dialogue_turn_audio",
      "text": "Haben Sie am Samstag Zeit?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-5a8ee37178ba28584540cc1f",
      "kind": "dialogue_turn_audio",
      "text": "Am Montag kann ich leider nicht.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-5ad00106ea8a5b6f5ef33ab4",
      "kind": "dialogue_turn_audio",
      "text": "Ja, kommen Sie am Dienstag um elf Uhr.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-5cff93784fa95a2c2c9689d5",
      "kind": "dialogue_turn_audio",
      "text": "Was tut Ihnen weh?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-5d1d342dcaf815b76cf7e208",
      "kind": "dialogue_turn_audio",
      "text": "Ja, das Schlafzimmer ist noch frei.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-61b371209a7bc27eab64cd39",
      "kind": "dialogue_turn_audio",
      "text": "Meine Ärztin sagt das.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-637e2fc484c2fb53061a2eb7",
      "kind": "dialogue_turn_audio",
      "text": "Ich will Politikerin werden.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-66cbc0d502cff3e8995c4088",
      "kind": "dialogue_turn_audio",
      "text": "Nehmen Sie bitte die Tablette.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-6b862e1965519ab5f3e2a80c",
      "kind": "dialogue_turn_audio",
      "text": "Können Sie die Heizung reparieren?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-6d5af8d342d71d78e30b4f10",
      "kind": "dialogue_turn_audio",
      "text": "Ja, nach dem Unterricht am Dienstag habe ich Zeit.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-6d69350bd51c22839a2a29bb",
      "kind": "dialogue_turn_audio",
      "text": "Der Kühlschrank funktioniert nicht.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-6d7aa5bf55fc2d26223ae456",
      "kind": "dialogue_turn_audio",
      "text": "Können Sie die Waschmaschine reparieren?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-6e21160f7323c686add71f78",
      "kind": "dialogue_turn_audio",
      "text": "Ja, das Bad mag ich besonders.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-705bb337125fb013576bed80",
      "kind": "dialogue_turn_audio",
      "text": "Nein, ohne ein Instrument können wir nicht anfangen.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-73fc744e64fc1acabf271919",
      "kind": "dialogue_turn_audio",
      "text": "Haben Sie am Donnerstag Zeit?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-746b6b104388d6a36fcbf635",
      "kind": "dialogue_turn_audio",
      "text": "Ich will den Führerschein machen.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-7495785f0c2fe7897c2fc865",
      "kind": "dialogue_turn_audio",
      "text": "Das ist die Küche.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-75196b7018b8f49d85efdee6",
      "kind": "dialogue_turn_audio",
      "text": "Wer sagt das?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-751bcdcfe4c926aebaa83aeb",
      "kind": "dialogue_turn_audio",
      "text": "Ich will unbedingt eine Familie haben.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-762a21d8e91231f1f57962e7",
      "kind": "dialogue_turn_audio",
      "text": "Können Sie das bitte wiederholen?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-76eb5cec45ee1103da5d5745",
      "kind": "dialogue_turn_audio",
      "text": "Haben Sie am Montag Zeit?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-77543667855da288d101b1c9",
      "kind": "dialogue_turn_audio",
      "text": "Ich finde seinen Sessel schön.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-779c88366913e2d3cd1d4003",
      "kind": "dialogue_turn_audio",
      "text": "Ich will ein Instrument lernen.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-77defd939bd043d2d34ad4a8",
      "kind": "dialogue_turn_audio",
      "text": "Gehen Sie bitte nach Hause.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-7bf2c48fab18f314c24316f3",
      "kind": "dialogue_turn_audio",
      "text": "Ist das Toms Lampe?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-7c8394e01065bdf44bff3e5d",
      "kind": "dialogue_turn_audio",
      "text": "Mein Kopf tut weh.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-7dd84f9144c1f404d6200b51",
      "kind": "dialogue_turn_audio",
      "text": "Ja, die Wohnung hat einen Garten.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-7ee91ce8130d12ab08eb9cb7",
      "kind": "dialogue_turn_audio",
      "text": "Mein Vater sagt das.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-813c5f401ab0203276845d5d",
      "kind": "dialogue_turn_audio",
      "text": "Wann kommen Sie?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-81f4b4287a4cedefd5cf6d73",
      "kind": "dialogue_turn_audio",
      "text": "Ja, ich brauche Ihre Hilfe.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-841611b31cbce7aca8bf3714",
      "kind": "dialogue_turn_audio",
      "text": "Ich will Schauspielerin werden.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-85d3afffaa6458e13d11cb30",
      "kind": "dialogue_turn_audio",
      "text": "Ich finde ihren Tisch zu groß.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-879f15f6565ccaff48a04a79",
      "kind": "dialogue_turn_audio",
      "text": "Hat die Wohnung eine Küche?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-87bf0c192ad149d48de6f4c2",
      "kind": "dialogue_turn_audio",
      "text": "Ja, die Wohnung hat ein Kinderzimmer.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-8bab74b907fd71fe4d783a4e",
      "kind": "dialogue_turn_audio",
      "text": "Ich will eine Familie haben.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-8e41aab54e4cee979006f852",
      "kind": "dialogue_turn_audio",
      "text": "Ich will unbedingt den Führerschein machen.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-8ff8e16b468a2871cdc9b355",
      "kind": "dialogue_turn_audio",
      "text": "Ja, die Wohnung hat ein Arbeitszimmer.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-9542d56374a328618a9ec394",
      "kind": "dialogue_turn_audio",
      "text": "Am Samstag kann ich leider nicht.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-961757449220e9a164f401e0",
      "kind": "dialogue_turn_audio",
      "text": "Was ist das hier?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-99a500aadcb42a85d3559ea6",
      "kind": "dialogue_turn_audio",
      "text": "Können Sie die Dusche reparieren?",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-9ca2d9d935611d63a6ab556c",
      "kind": "dialogue_turn_audio",
      "text": "Spreche ich undeutlich?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-9e76f7c20b63dc4f4c63e077",
      "kind": "dialogue_turn_audio",
      "text": "Ja, das Arbeitszimmer ist noch frei.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-9fc8705a9930f41694bc3e26",
      "kind": "dialogue_turn_audio",
      "text": "Ich komme in vier Stunden.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-a0b798dd8b6836e4a1d26ec7",
      "kind": "dialogue_turn_audio",
      "text": "Das Telefon funktioniert nicht.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-a0c4951325ea46686be25fac",
      "kind": "dialogue_turn_audio",
      "text": "Ja, kommen Sie morgen um acht Uhr.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-a1972577309fa6cb4449e45e",
      "kind": "dialogue_turn_audio",
      "text": "Was soll ich machen?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-a2ae5de7ec2dd93bf6873f7b",
      "kind": "dialogue_turn_audio",
      "text": "Ich finde die Küche praktisch.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-a401cf04a302f6f0fa70e9c2",
      "kind": "dialogue_turn_audio",
      "text": "Ja, das ist sein Sofa.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-a7d9bae80467705d9d2d4dd0",
      "kind": "dialogue_turn_audio",
      "text": "Ja, das ist ihr Tisch.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-a80a50eeb766f710a4489468",
      "kind": "dialogue_turn_audio",
      "text": "Ja, das ist ihr Bett.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-a85587036fde25129918157a",
      "kind": "dialogue_turn_audio",
      "text": "Nein, ich habe Ohrenschmerzen.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-aa4c09edc29db4f65c61e7c3",
      "kind": "dialogue_turn_audio",
      "text": "Ja, das Telefon kann ich reparieren.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-aaea178f3cb6ec64fa921c92",
      "kind": "dialogue_turn_audio",
      "text": "Ich will nächsten Monat eine Ausbildung machen.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-ac89a23af98029f31fb19337",
      "kind": "dialogue_turn_audio",
      "text": "Sie kostet 730 Euro im Monat.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-ad498a23965c97fe4c7df1cb",
      "kind": "dialogue_turn_audio",
      "text": "Ja, den Balkon mag ich besonders.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-ae266f98b0f55cda8ea2cb4d",
      "kind": "dialogue_turn_audio",
      "text": "Ja, die Küche mag ich besonders.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-af4f1cb28f028421cf8c4409",
      "kind": "dialogue_turn_audio",
      "text": "Können Sie die Steckdose reparieren?",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-b39a991b514c87cb20cde18f",
      "kind": "dialogue_turn_audio",
      "text": "Am Dienstag kann ich leider nicht.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-b46d502dc3fab6b198606cae",
      "kind": "dialogue_turn_audio",
      "text": "Ich komme in zwei Stunden.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-b89acc448a4f2a68987b26c1",
      "kind": "dialogue_turn_audio",
      "text": "Ist das Schlafzimmer noch frei?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-b8d4a26bf50769c2a03f06e9",
      "kind": "dialogue_turn_audio",
      "text": "Ja, nach der Arbeit am Mittwoch habe ich Zeit.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-b9a98e2370109bd34fa5c2f6",
      "kind": "dialogue_turn_audio",
      "text": "Mit wem kommst du?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-ba0373a35f71a11e7b52fd95",
      "kind": "dialogue_turn_audio",
      "text": "Könnt ihr ohne ein Instrument anfangen?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-bb6d2bb940ca77328de958f1",
      "kind": "dialogue_turn_audio",
      "text": "Ist das Toms Sofa?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-bc0916ff177553a6368be510",
      "kind": "dialogue_turn_audio",
      "text": "Ich komme in drei Stunden.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-bc387656a83d58ceb25bcec8",
      "kind": "dialogue_turn_audio",
      "text": "Ja, kommen Sie am Freitag um zehn Uhr.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-bc424403ca058ddce6abdb2e",
      "kind": "dialogue_turn_audio",
      "text": "Wie findest du Toms Lampe?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-bcf52f5b1d130357fd5e56ff",
      "kind": "dialogue_turn_audio",
      "text": "Haben Sie am Dienstag Zeit?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-bd7352dfe4830f28756c0369",
      "kind": "dialogue_turn_audio",
      "text": "Hat die Wohnung ein Kinderzimmer?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-bdb7f4713bb7e8b8d691e009",
      "kind": "dialogue_turn_audio",
      "text": "Ich will Lehrerin werden.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-be9f1bb8ecfcaa651c6e170f",
      "kind": "dialogue_turn_audio",
      "text": "Am Donnerstag kann ich leider nicht.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-c041564b98f48e010e96ab82",
      "kind": "dialogue_turn_audio",
      "text": "Ich komme mit meiner Schwester.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-c09e7e0887d1ccb9833e1576",
      "kind": "dialogue_turn_audio",
      "text": "Was kostet die Wohnung im Monat?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-c219ed6d27a40d7c339d683f",
      "kind": "dialogue_turn_audio",
      "text": "Können Sie das Telefon reparieren?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-c35b1fd88ce646dfe9745c3f",
      "kind": "dialogue_turn_audio",
      "text": "Ja, natürlich.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-c4046c8f3313a093d32a653c",
      "kind": "dialogue_turn_audio",
      "text": "Ich komme mit meiner Familie.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-c435a36f33370723a6800ec5",
      "kind": "dialogue_turn_audio",
      "text": "Ich will auf keinen Fall Motorrad fahren.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-c49745dd2fa059f5dcae595d",
      "kind": "dialogue_turn_audio",
      "text": "Es kostet 410 Euro im Monat.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-c4a8e5822f98097024db342d",
      "kind": "dialogue_turn_audio",
      "text": "Am Donnerstag um 10 Uhr habe ich Zeit.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-c53b957af6911c12d5cedb11",
      "kind": "dialogue_turn_audio",
      "text": "Ich will viele Fremdsprachen lernen.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-c54d1334a76a99445612ef3a",
      "kind": "dialogue_turn_audio",
      "text": "Können Sie den Fernseher reparieren?",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-c55801065c8b57a3bfa3e816",
      "kind": "dialogue_turn_audio",
      "text": "Am Montag um 9 Uhr habe ich Zeit.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-c8ab67e124175f8db33463a0",
      "kind": "dialogue_turn_audio",
      "text": "Ich will unbedingt Schauspieler werden.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-ca40183ed5454eda6e56cb3a",
      "kind": "dialogue_turn_audio",
      "text": "Mein Fuß tut weh.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-cbace8304db3fb412fd6e107",
      "kind": "dialogue_turn_audio",
      "text": "Mein Lehrer sagt das.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-cbae54579cea24f4348a85fa",
      "kind": "dialogue_turn_audio",
      "text": "Nein, ohne eine Ausbildung können wir nicht anfangen.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-cc0408efc22457759d371905",
      "kind": "dialogue_turn_audio",
      "text": "Ist das Klaras Bett?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-cd00c5983a5bc571b7215fee",
      "kind": "dialogue_turn_audio",
      "text": "Nein, ohne den Führerschein können wir nicht anfangen.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-cd167cb6179e97816a8cc72f",
      "kind": "dialogue_turn_audio",
      "text": "Was hat die Ärztin gesagt?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-cd5935a9e51b7467b3f608c3",
      "kind": "dialogue_turn_audio",
      "text": "Ja, nach der Arbeit am Donnerstag habe ich Zeit.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-ce203e76bf45ba35dda72b59",
      "kind": "dialogue_turn_audio",
      "text": "Das ist das Schlafzimmer.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-ce51f0ffd96e6861b883e6be",
      "kind": "dialogue_turn_audio",
      "text": "Ich will unbedingt im Ausland leben.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-cf541e22b859e654c6efc1aa",
      "kind": "dialogue_turn_audio",
      "text": "Meine Mutter sagt das.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-d4dbc9d4a6f1dbb1ed46437a",
      "kind": "dialogue_turn_audio",
      "text": "Soll ich am Freitag kommen?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-d65c9f25040829e1ae125310",
      "kind": "dialogue_turn_audio",
      "text": "Ja, die Wohnung ist noch frei.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-d78a1e269e28850092594912",
      "kind": "dialogue_turn_audio",
      "text": "Nein, ich habe Halsschmerzen.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-d85252f937a24d9ce5ee9132",
      "kind": "dialogue_turn_audio",
      "text": "Ich komme mit einer Freundin.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-d864d5e5909a4b1eb082d951",
      "kind": "dialogue_turn_audio",
      "text": "Wie findest du Toms Sessel?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-dd6efee7f9b5c09e019d1636",
      "kind": "dialogue_turn_audio",
      "text": "Trinken Sie bitte viel Wasser.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-de372c14a127b059f8470ad7",
      "kind": "dialogue_turn_audio",
      "text": "Soll ich morgen kommen?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-de68865cf822126f6aab206f",
      "kind": "dialogue_turn_audio",
      "text": "Können wir den Termin verschieben?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-dea49af5f8ef0c75a8ea5d07",
      "kind": "dialogue_turn_audio",
      "text": "Ich finde das Sofa schön.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-e2f9e3168bb1c1a6ccac3ac0",
      "kind": "dialogue_turn_audio",
      "text": "Könnt ihr ohne den Führerschein anfangen?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-e4eb22ea7a2e968cd1204cd2",
      "kind": "dialogue_turn_audio",
      "text": "Ich will um die Welt segeln.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-eb46617cdab2e64eb0d23059",
      "kind": "dialogue_turn_audio",
      "text": "Ja, den Kühlschrank kann ich reparieren.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-f1636a02d98d8c6de93fb9a4",
      "kind": "dialogue_turn_audio",
      "text": "Ich komme in einer halben Stunde.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-f38a77f6a75709908e8b94e7",
      "kind": "dialogue_turn_audio",
      "text": "Machen Sie bitte diese Übung.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-f46d233d519c4544533380f9",
      "kind": "dialogue_turn_audio",
      "text": "Ich soll eine Pause machen.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-f604a854d1d9c265924a24b6",
      "kind": "dialogue_turn_audio",
      "text": "Soll ich am Montag kommen?",
      "voice": "de-DE-KatjaNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-f97cff7a524299de54e7f37e",
      "kind": "dialogue_turn_audio",
      "text": "Mein Arm tut weh.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-facd18438ff3f8bb74e9674c",
      "kind": "dialogue_turn_audio",
      "text": "Ich will auf keinen Fall Chef werden.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-fc955f2e6587284c42866c73",
      "kind": "dialogue_turn_audio",
      "text": "Die Heizung funktioniert nicht.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-fcd20166f3ddafdeba6c9035",
      "kind": "dialogue_turn_audio",
      "text": "Ich finde das Bett zu klein.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    },
    {
      "id": "PPI-fe9b9a9782cb30742497937e",
      "kind": "dialogue_turn_audio",
      "text": "Ich soll viel Wasser trinken.",
      "voice": "de-DE-ConradNeural",
      "status": "not_generated"
    }
  ]
}
