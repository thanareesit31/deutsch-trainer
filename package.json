{
  "name": "deutsch-mit-sun",
  "version": "5.0.0",
  "private": true,
  "scripts": {
    "dev": "bun run --bun next dev",
    "build": "bun run --bun next build",
    "start": "bun run --bun next start",
    "typecheck": "bun run --bun next typegen && tsc --noEmit",
    "test": "bun test tests/engine.test.ts tests/learning.test.ts",
    "test:e2e": "node tests/browser.mjs",
    "test:learning-db": "node tests/learning-database.mjs",
    "test:learning-browser": "node tests/learning-browser.mjs",
    "test:verb-browser": "node tests/verb-learning-browser.mjs",
    "db:migrate-lessons": "node --env-file=.env.local scripts/migrate-lesson-states.mjs",
    "test:lesson-browser": "node tests/lesson-states-browser.mjs",
    "test:lesson-db": "node tests/lesson-states-database.mjs",
    "db:migrate-content": "node --env-file=.env.local scripts/migrate-content.mjs",
    "dev:restart": "bash scripts/restart-local.sh",
    "dev:test": "bash scripts/start-test-workspace.sh",
    "dev:test:reset": "TEST_WORKSPACE_RESET=1 bash scripts/start-test-workspace.sh",
    "test:workspace": "node --test tests/test-workspace.test.mjs",
    "test:workspace-browser": "node tests/test-workspace-browser.mjs",
    "test:l02": "node --import tsx --test tests/l02-learning.test.ts",
    "test:l02-browser": "node --import tsx tests/l02-learning-browser.mjs",
    "test:practice-account-browser": "node tests/account-practice-browser.mjs",
    "test:vocabulary-practice-browser": "node tests/l13-vocabulary-practice-browser.mjs",
    "test:vocabulary-practice-db": "node tests/vocabulary-practice-database.mjs",
    "db:migrate-practice": "node --env-file=.env.local scripts/migrate-practice-accounts.mjs",
    "test:vocabulary-learner-rollout": "node tests/vocabulary-learner-rollout-browser.mjs",
    "test:vocabulary-production-smoke": "node tests/vocabulary-production-smoke.mjs",
    "test:phrase-practice-db": "node tests/phrase-practice-database.mjs",
    "test:phrase-practice-browser": "node tests/l13-phrase-practice-browser.mjs",
    "build:phrase-practice": "node scripts/exercise-mapping/build-l13-phrases.mjs",
    "audit:l13-vocabulary-challenge": "node --import tsx scripts/exercise-mapping/audit-l13-vocabulary-challenge.mjs",
    "test:l13-vocabulary-challenge": "node --import tsx --test tests/l13-vocabulary-challenge.test.ts",
    "test:l13-vocabulary-challenge-browser": "node --import tsx tests/l13-vocabulary-challenge-browser.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.78.0",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pg": "^8.23.1",
    "playwright-core": "1.63.0",
    "tsx": "4.15.7",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0",
    "bun": ">=1.3.0"
  }
}
